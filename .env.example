# ==============================================================================
#                      CONFIGURATEUR D'ENVIRONNEMENT SENTINEL
# ==============================================================================
# Ce fichier recense TOUTES les variables d'environnement pour l'ensemble des
# microservices de la plateforme (Sentinel, Nexus, Atrium, Web et Infrastructure).
#
# Copiez ce fichier sous le nom `.env` a la racine du projet et adaptez les valeurs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE COMMUNE (PostgreSQL, Redis & Docker)
# ------------------------------------------------------------------------------
# POSTGRES_PASSWORD : Mot de passe du compte SUPERUSER `sentinel` du cluster.
# Il ne sert plus qu'aux one-shot `*-db-init` (creation des roles et des bases)
# et a pgadmin. AUCUN service applicatif ne s'y connecte : un superuser ignore
# tous les GRANT, donc ses identifiants ouvriraient les quatre bases.
POSTGRES_PASSWORD=sentinel_secret

# Mots de passe des roles APPLICATIFS, un par base logique. Chacun ne possede
# que sa propre base et ne peut pas ouvrir de session sur les autres.
# SENTINEL_DB_PASSWORD : role `sentinel_app` (base discord_sentinel) — utilise
# par sentinel-api, sentinel-worker et ops-api.
SENTINEL_DB_PASSWORD=sentinel_app_secret
# ATRIUM_DB_PASSWORD : role `atrium` (base atrium).
ATRIUM_DB_PASSWORD=atrium_secret

# REDIS_PASSWORD : Mot de passe d'authentification pour le bus d'evenements et cache Redis.
REDIS_PASSWORD=sentinel_redis

# DOCKER_GID : ID numérique du groupe `docker` sur l'hote (proprietaire du socket /var/run/docker.sock).
# Porte par le SEUL conteneur qui monte le socket : docker-agent. Ni l'API
# Sentinel ni l'API Nexus ne le montent — elles passent par l'agent en HTTP.
# Obtenir sur le serveur avec : stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

# COMPOSE_PROFILES : Profils Docker Compose actives par defaut lors de la commande `docker compose up -d`.
# Valeurs possibles (separees par virgules) :
# - nexus : plateforme jeux
# - atrium : moderation conversationnelle + Ollama local
# - monitoring : outils + observabilite (profil historique complet)
# - tools : pgAdmin + Redis Commander uniquement
# - observability : Prometheus + Grafana uniquement
# - full : Nexus + Atrium + outils + observabilite (TLS exclu)
# - tls : Certbot / Let's Encrypt
COMPOSE_PROFILES=nexus

# ------------------------------------------------------------------------------
# 2. SENTINEL — API BACKEND & SECURITE ADMINISTRATEUR
# ------------------------------------------------------------------------------
# SENTINEL_API_KEY : Cle d'API secrete partagee pour authentifier les appels vers l'API Backend Sentinel.
SENTINEL_API_KEY=your_sentinel_api_key_here

# SENTINEL_REQUIRE_API_KEY : Si `true` (defaut en prod), exige la cle `SENTINEL_API_KEY` sur les requetes HTTP.
# Mettre a `false` uniquement lors des phases de developpement local sans authentification.
SENTINEL_REQUIRE_API_KEY=false

# ALLOWED_ORIGINS : Domaines autorises pour les requetes CORS cross-origin (separes par virgule).
# En prod avec Nginx sur le meme domaine : laisser vide (proxy relatif).
# Si le frontend Web est heberge sur un autre domaine/port : indiquer l'URL exacte (ex: https://labandeducanap.fr,http://localhost:5173).
ALLOWED_ORIGINS=

# SUPERADMIN_USER_IDS : IDs Discord des Super-Administrateurs autorises sur le Back-Office Web (separes par virgule).
# SECURITE FAIL-CLOSED : Si cette liste est vide, l'acces au Dashboard Web est strictement interdit a TOUS les humains (403).
SUPERADMIN_USER_IDS=123456789012345678,987654321098765432

# SECURITY_ALERTS_WEBHOOK : Webhook Discord optionnel pour l'envoi direct des alertes de securite critiques.
SECURITY_ALERTS_WEBHOOK=

# METRICS_TOKEN : Token optionnel pour securiser l'endpoint /metrics de Prometheus (vide = ouvert en reseau interne).
METRICS_TOKEN=

# ------------------------------------------------------------------------------
# 3. SENTINEL — BOT DISCORD PRINCIPAL & AUTHENTIFICATION OAUTH2
# ------------------------------------------------------------------------------
# SENTINEL_BOT_TOKEN : Token d'authentification du Bot Discord principal Sentinel.
# Ce bot unifie les fonctions de Moderation, Tickets, Salons Vocaux, Niveaux, Securite et Casino.
SENTINEL_BOT_TOKEN=your_sentinel_bot_token_here

# MESSAGE_CACHE_SIZE : nombre de messages recents conserves en RAM par serveur
# pour afficher le contenu precedent lors d'une edition ou suppression.
# Valeur bornee par le bot entre 100 et 100000 (defaut recommande : 10000).
MESSAGE_CACHE_SIZE=10000

# DISCORD_CLIENT_ID : Client ID de l'application Discord (dans le Discord Developer Portal).
# Utilise pour la connexion OAuth2 des utilisateurs sur le Dashboard Web.
DISCORD_CLIENT_ID=your_discord_client_id_here

# DISCORD_CLIENT_SECRET : Client Secret de l'application Discord (NE JAMAIS EXPOSER COTE FRONTEND).
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# DISCORD_REDIRECT_URI : URL de redirection enregistree dans le portail Discord apres connexion OAuth2.
# Exemple en prod : https://labandeducanap.fr/auth/discord/callback ou http://localhost:3000/auth/discord/callback en dev.
DISCORD_REDIRECT_URI=https://labandeducanap.fr/auth/discord/callback

# WEB_FRONT_URL : URL absolue du frontend Web ou rediriger l'utilisateur apres validation OAuth2.
# Exemple en prod : https://labandeducanap.fr ou http://localhost:5173 en dev.
WEB_FRONT_URL=https://labandeducanap.fr

# ------------------------------------------------------------------------------
# 4. SENTINEL — IA DE MODERATION DU CHAT (DeepSeek LLM & ONNX)
# ------------------------------------------------------------------------------
# DEEPSEEK_MODERATION_API_KEY : Cle API Cloud DeepSeek isolee dediee uniquement a la moderation du chat.
# Permet de suivre le budget et la consommation de moderation separement.
DEEPSEEK_MODERATION_API_KEY=your_deepseek_moderation_api_key_here

# DEEPSEEK_MODERATION_MODEL : Modele LLM utilise pour la moderation automatique (defaut: deepseek-chat).
DEEPSEEK_MODERATION_MODEL=deepseek-chat

# DEEPSEEK_MODERATION_ENDPOINT : URL de l'API OpenAI-compatible pour la moderation (defaut officiel DeepSeek).
DEEPSEEK_MODERATION_ENDPOINT=https://api.deepseek.com/chat/completions

# VISION_MODEL_PATH : Chemin vers le fichier du modele vision ONNX local (fallback si actif).
VISION_MODEL_PATH=./models/vision_sentinel.onnx

# TEXT_MODEL_PATH : Chemin vers le fichier du modele de classification de texte ONNX local.
TEXT_MODEL_PATH=./models/text_sentinel.onnx

# TEXT_TOKENIZER_PATH : Chemin vers le fichier de vocabulaire/tokenizer JSON pour le modele ONNX local.
TEXT_TOKENIZER_PATH=./models/tokenizer.json

# TEXT_MAX_LENGTH : Longueur maximale en tokens traitee par le tokenizer ONNX local (defaut: 256).
TEXT_MAX_LENGTH=256

# ------------------------------------------------------------------------------
# 5. ATRIUM — IA D'ACCUEIL, RAG & BOT D'INTERACTION
# ------------------------------------------------------------------------------
# ATRIUM_DISCORD_TOKEN : Token du Bot Discord dedie a l'accueil interactif Atrium (distinct des autres bots).
ATRIUM_DISCORD_TOKEN=your_atrium_discord_token_here

# ATRIUM_API_TOKEN : Jeton secret partage pour securiser la communication entre Atrium-Bot et Atrium-API (min 32 chars).
# Egalement injecte cote serveur par nginx dans le proxy /atrium-api/ : c'est
# ce qui permet au back-office d'atteindre Atrium. Sans lui, la page
# « Accueil IA » repondra 401. Ne parvient JAMAIS au navigateur.
ATRIUM_API_TOKEN=change_me_with_a_long_random_secret_atrium

# ATRIUM_GRPC_TOKEN : Jeton Bearer interne entre Atrium-Bot et Atrium-API gRPC (min 32 chars, distinct de l'API HTTP).
ATRIUM_GRPC_TOKEN=change_me_with_a_different_long_random_grpc_secret

# ATRIUM_API_BIND_ADDR : Adresse IP et port d'ecoute HTTP pour l'API Backend Atrium (defaut: 0.0.0.0:8090).
ATRIUM_API_BIND_ADDR=0.0.0.0:8090

# ATRIUM_GRPC_BIND_ADDR : Adresse IP et port d'ecoute du serveur interne gRPC Atrium (defaut: 0.0.0.0:8091).
ATRIUM_GRPC_BIND_ADDR=0.0.0.0:8091

# ATRIUM_DEEPSEEK_API_KEY : Cle API Cloud DeepSeek dediee a l'IA d'accueil interactif et au RAG Atrium.
ATRIUM_DEEPSEEK_API_KEY=your_atrium_deepseek_api_key_here

# ATRIUM_DEEPSEEK_MODEL : Modele DeepSeek utilise par l'accueil Atrium (defaut: deepseek-v4-flash).
ATRIUM_DEEPSEEK_MODEL=deepseek-v4-flash

# ATRIUM_GENERAL_CHANNEL_ID : ID du salon Discord general ou le bot Atrium intervient pour accueillir les membres.
ATRIUM_GENERAL_CHANNEL_ID=your_general_channel_id_here

# ATRIUM_SERVER_CONTEXT : Description contextuelle du serveur (regles, presentation) fournie a l'IA Atrium.
ATRIUM_SERVER_CONTEXT="Serveur gaming convivial dedie a la communaute LaBandeDuCanap."

# ATRIUM_API_RATE_LIMIT_PER_SEC : Limite de requetes HTTP par seconde autorisee par IP sur l'API Atrium (defaut: 5).
ATRIUM_API_RATE_LIMIT_PER_SEC=5

# ATRIUM_METRICS_TOKEN : Token optionnel pour securiser /metrics d'Atrium-API.
# Vide = ouvert sur le reseau interne ou Prometheus scrape, comme les deux
# autres API.
ATRIUM_METRICS_TOKEN=

# Active les minuteries Atrium dans l'unique platform-scheduler. Doit rester
# false si le profil Atrium n'est pas deploye.
SCHEDULER_ATRIUM_ENABLED=true

# ATRIUM_SUMMARY_INTERVAL_SECS : Frequence de regeneration du resume d'activite
# par platform-scheduler (defaut : une fois par jour).
ATRIUM_SUMMARY_INTERVAL_SECS=86400
ATRIUM_RETENTION_INTERVAL_SECS=86400

# Les trois quotas ci-dessous ne sont plus que des valeurs de REPLI : ils
# s'appliquent a un serveur qui n'a rien regle. Le reglage par serveur se fait
# depuis la page « Accueil IA » du back-office et vit dans `bot_guild_config`
# (base atrium). Changer une valeur ici n'ecrase donc aucun reglage existant.

# ATRIUM_USER_COOLDOWN_SECS : Delai d'attente (cooldown) en secondes exige entre 2 questions d'un meme membre (defaut: 10).
ATRIUM_USER_COOLDOWN_SECS=10

# ATRIUM_USER_DAILY_LIMIT : Quota maximum de questions par jour et par utilisateur pour l'IA Atrium (defaut: 30).
ATRIUM_USER_DAILY_LIMIT=30

# ATRIUM_GLOBAL_DAILY_LIMIT : Quota maximum global de questions par jour pour l'IA Atrium (defaut: 500).
ATRIUM_GLOBAL_DAILY_LIMIT=500

# ATRIUM_RAG_DATABASE_URL : URL de connexion PostgreSQL a la base de donnees dediee au RAG Atrium.
# En Docker : laisser vide (utilise automatiquement postgres://sentinel:<POSTGRES_PASSWORD>@atrium-pgbouncer:5432/atrium).
ATRIUM_RAG_DATABASE_URL=

# ATRIUM_EMBEDDINGS_BASE_URL : URL de l'API d'embeddings vectoriels (Ollama local ou OpenAI).
# Defaut Docker : http://atrium-ollama:11434/v1 (gratuit et local). Si OpenAI : https://api.openai.com/v1
ATRIUM_EMBEDDINGS_BASE_URL=http://atrium-ollama:11434/v1

# ATRIUM_EMBEDDINGS_API_KEY : Cle API pour les embeddings (laisser vide si Ollama local).
ATRIUM_EMBEDDINGS_API_KEY=

# ATRIUM_EMBEDDINGS_MODEL : Modele d'vectorisation/embeddings (defaut Ollama: nomic-embed-text ; defaut OpenAI: text-embedding-3-small).
ATRIUM_EMBEDDINGS_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 6. NEXUS — PLATEFORME DE SERVEURS DE JEUX (Nexus-API, Nexus-Bot, Nexus-Worker)
# ------------------------------------------------------------------------------
# NEXUS_BOT_TOKEN : Token du Bot Discord dedie a la gestion du portail de jeux Nexus (distinct de SENTINEL_BOT_TOKEN).
NEXUS_BOT_TOKEN=your_nexus_bot_token_here

# NEXUS_API_KEY : Cle d'API partagee pour authentifier les requetes internes entre Nexus-API, Bot et Worker.
NEXUS_API_KEY=your_nexus_api_key_here

# NEXUS_REDIS_PASSWORD : Mot de passe de l'instance Redis DEDIEE a Nexus
# (service `nexus-redis`). Elle porte la stream `nexus:events` et les
# reservations de ports de jeu. Separee du Redis commun pour que les bots et
# workers des autres plateformes ne lisent pas le trafic du portail — et
# reglee en `noeviction`, car evincer une reservation de port ferait attribuer
# le meme port a deux serveurs.
NEXUS_REDIS_PASSWORD=nexus_redis_secret

# NEXUS_DB_PASSWORD : Mot de passe du role PostgreSQL `nexus`, cree au boot par
# nexus-db-init. Ce role possede la base `nexus` et RIEN d'autre — il n'est pas
# superuser, contrairement a POSTGRES_PASSWORD/`sentinel`. C'est ce qui empeche
# la plateforme jeux d'atteindre discord_sentinel ou atrium.
# Le changer ici et redemarrer suffit : nexus-db-init resynchronise le mot de passe.
NEXUS_DB_PASSWORD=nexus_secret

# NEXUS_METRICS_TOKEN : Token optionnel pour securiser l'endpoint /metrics de Nexus-API.
NEXUS_METRICS_TOKEN=

# NEXUS_GAME_RUNTIME : Runtime des conteneurs de jeux. `docker` (production reel) ou `noop` (mock de developpement).
# Passer a `docker` pour que Nexus instancie vraiment les serveurs de jeux Minecraft, Valheim, Palworld, etc.
NEXUS_GAME_RUNTIME=docker

# GAME_PORTAL_PORT_RESERVATION_TTL_SECS : Duree de reservation temporaire des ports de jeux (en secondes).
GAME_PORTAL_PORT_RESERVATION_TTL_SECS=300

# Active les minuteries Nexus dans l'unique platform-scheduler. Doit rester
# false si le profil Nexus n'est pas deploye.
SCHEDULER_NEXUS_ENABLED=true

# Cadence d'execution des jobs Nexus par platform-scheduler (en secondes).
GAME_HEALTH_CHECK_INTERVAL_SECS=30
GAME_IDLE_SHUTDOWN_CHECK_INTERVAL_SECS=3600
GAME_RECONCILER_INTERVAL_SECS=3600
GAME_IMAGE_CLEANUP_INTERVAL_SECS=86400

# Politique locale du docker-agent pour les serveurs Nexus. Une image ajoutee
# dans game_templates doit aussi etre ajoutee ici avant de pouvoir etre tiree
# ou executee. Les listes root/command restent des sous-ensembles explicites.
DOCKER_AGENT_GAME_IMAGES=itzg/minecraft-server:latest,lloesche/valheim-server:latest,factoriotools/factorio:stable,thijsvanloef/palworld-server-docker:latest,hermsi/ark-server:latest,vinanrra/7dtd-server:latest,ryshe/terraria:tshock-1.4.5.6-6.1.0
DOCKER_AGENT_GAME_ROOT_IMAGES=lloesche/valheim-server:latest,factoriotools/factorio:stable,thijsvanloef/palworld-server-docker:latest,hermsi/ark-server:latest,vinanrra/7dtd-server:latest,ryshe/terraria:tshock-1.4.5.6-6.1.0
DOCKER_AGENT_GAME_COMMAND_IMAGES=ryshe/terraria:tshock-1.4.5.6-6.1.0
DOCKER_AGENT_GAME_NETWORK=sentinel-games
DOCKER_AGENT_GAME_CONTAINER_USER=1000:1000
DOCKER_AGENT_GAME_PORT_START=25500
DOCKER_AGENT_GAME_PORT_END=25599
DOCKER_AGENT_RCON_PORT_START=25700
DOCKER_AGENT_RCON_PORT_END=25799
GAME_REVEAL_IP_INTERVAL_SECS=300
GAME_DAILY_PING_INTERVAL_SECS=3600

# ------------------------------------------------------------------------------
# 7. MODULES SENTINEL OPTIONNELS (Voice & Tickets)
# ------------------------------------------------------------------------------
# VOICE_GUILD_ID : ID Discord du serveur cible ou le module de salons vocaux dynamiques est actif.
VOICE_GUILD_ID=your_guild_id

# VOICE_PUBLIC_CREATOR_CHANNEL_ID : ID du salon vocal declencheur pour la creation de salons vocaux publics.
VOICE_PUBLIC_CREATOR_CHANNEL_ID=your_public_creator_channel_id

# VOICE_PRIVATE_CREATOR_CHANNEL_ID : ID du salon vocal declencheur pour la creation de salons vocaux prives.
VOICE_PRIVATE_CREATOR_CHANNEL_ID=your_private_creator_channel_id

# VOICE_LOG_CHANNEL_ID : ID du salon texte Discord ou sont enregistres les evenements du module vocal.
VOICE_LOG_CHANNEL_ID=your_log_channel_id

# TICKET_CATEGORY_ID : ID de la categorie Discord sous laquelle les nouveaux tickets de support sont crees.
TICKET_CATEGORY_ID=your_ticket_category_id

# TICKET_CHANNEL_ID : ID du salon texte ou le panneau d'ouverture de tickets est affiche.
TICKET_CHANNEL_ID=your_ticket_channel_id

# ------------------------------------------------------------------------------
# 8. WEB DASHBOARD & CERTIFICATS TLS / LET'S ENCRYPT
# ------------------------------------------------------------------------------
# WEB_DOMAIN : Nom de domaine public pointant vers votre serveur (ex: labandeducanap.fr ou localhost en dev).
WEB_DOMAIN=localhost

# WEB_DOMAIN_ALIASES : Autres noms DNS servis par le meme nginx, separes par des virgules.
# Ils sont ajoutes au certificat Let's Encrypt (ex: labandeducanap.ddns.net). Laisser vide si aucun.
WEB_DOMAIN_ALIASES=

# PUBLIC_GUILD_ID : ID du serveur Discord principal dont les donnees (planning, serveurs de jeux) sont affichees sur le site Web.
PUBLIC_GUILD_ID=123456789012345678

# DISCORD_INVITE : Lien d'invitation officiel Discord affiche sur les boutons du site Web (ex: https://discord.gg/votre_code).
DISCORD_INVITE=https://discord.gg/your_invite_code

# VITE_API_URL : URL absolue de l'API pour le frontend Vue. Laisser vide si l'API est servie sous le meme Nginx (relatif).
VITE_API_URL=

# LETSENCRYPT_EMAIL : Adresse email utilisee par Certbot pour enregistrer les certificats SSL Let's Encrypt.
LETSENCRYPT_EMAIL=your_email@domain.com

# LETSENCRYPT_STAGING : Mettre "1" pour utiliser l'environnement de test Let's Encrypt (évite le rate-limit pendant vos tests). Vide = Prod.
LETSENCRYPT_STAGING=

# ------------------------------------------------------------------------------
# 9. MONITORING (Profile optionnel `monitoring` : PgAdmin & Prometheus)
# ------------------------------------------------------------------------------
# PGADMIN_EMAIL : Email de connexion a l'interface Web PgAdmin pour gerer la base PostgreSQL.
PGADMIN_EMAIL=admin@sentinel.local

# PGADMIN_PASSWORD : Mot de passe de connexion a l'interface Web PgAdmin.
PGADMIN_PASSWORD=admin_password_here

# ------------------------------------------------------------------------------
# IDENTITE (auth-api)
# ------------------------------------------------------------------------------
# AUTH_API_TOKEN : Jeton des appelants de service de l'API d'identite (nginx pour
# l'auth_request, sentinel-api et ops-api comme consommateurs). Min 32 chars.
# Sans lui, /access et /security/* seraient ouverts a tout le reseau interne.
AUTH_API_TOKEN=change_me_with_a_long_random_secret_auth

# AUTH_DB_PASSWORD : Mot de passe du role PostgreSQL `auth`, cree au boot par
# auth-db-init. Cette base contient les access/refresh tokens Discord des
# administrateurs : c'est la plus sensible du deploiement. Le role n'est pas
# superuser et ne possede que sa propre base.
AUTH_DB_PASSWORD=auth_secret

# AUTH_REDIS_PASSWORD : Mot de passe de l'instance Redis DEDIEE a l'identite
# (service `auth-redis`). Distinct de REDIS_PASSWORD : sur l'instance commune,
# tout service porteur de REDIS_URL pourrait lire les `state` CSRF du flux
# OAuth et le cache « jeton -> identite ». Cette instance ne persiste rien sur
# disque et n'est joignable que par auth-api.
AUTH_REDIS_PASSWORD=auth_redis_secret

# OPS_GEOIP_ENABLED : autorise la resolution geographique des adresses IP par un
# service TIERS. Desactivee par defaut (`false`).
# Une adresse IP est une donnee personnelle au sens du RGPD : l'activer, c'est
# transferer les IP de tes visiteurs a un prestataire externe. Desactivee,
# l'ecran Securite affiche les IP sans pays — il ne casse pas.
OPS_GEOIP_ENABLED=false

# OPS_GEOIP_URL : point de terminaison de la resolution. Le defaut vise
# ip-api.com, dont le palier gratuit n'accepte que http:// — la requete et sa
# reponse circulent alors EN CLAIR, et un observateur du reseau voit quelles IP
# sont enquetees. Pointer sur un service TLS (palier payant ou instance
# auto-hebergee) supprime cette exposition.
OPS_GEOIP_URL=http://ip-api.com/batch

# ------------------------------------------------------------------------------
# DOCKER-AGENT
# ------------------------------------------------------------------------------
# DOCKER_AGENT_TOKEN : Jeton partage entre docker-agent et ses appelants
# (sentinel-api pour l'exploitation, nexus-api pour les serveurs de jeux). Min 32 chars.
# L'agent est le SEUL conteneur a monter /var/run/docker.sock, qui equivaut a un
# acces root sur l'hote. Il refuse de demarrer sans ce jeton : mieux vaut un
# service arrete qu'un socket ouvert a tout le reseau interne.
DOCKER_AGENT_TOKEN=change_me_with_a_long_random_secret_docker_agent

# DOCKER_AGENT_GAME_TOKEN : jeton de la surface /game/* (cycle de vie des
# serveurs de jeu), porte par nexus-api. DOIT etre DIFFERENT du precedent —
# l'agent refuse de demarrer s'ils sont identiques.
# Pourquoi deux : avec un jeton unique, les identifiants de nexus-api ouvraient
# aussi l'administration de l'hote (arreter ou purger n'importe quel conteneur,
# postgres et auth-api compris). On lui avait retire l'acces direct au socket
# pour lui donner la cle du processus qui l'a.
# REQUIS des que le profil `nexus` est actif, meme avec NEXUS_GAME_RUNTIME=noop.
DOCKER_AGENT_GAME_TOKEN=change_me_with_a_different_long_random_secret_game

# Le groupe proprietaire du socket se regle plus haut via DOCKER_GID (section 1).
# Il n'est porte QUE par docker-agent.

# ------------------------------------------------------------------------------
# EXPLOITATION (ops-api)
# ------------------------------------------------------------------------------
# OPS_API_TOKEN : Jeton entre nginx (/ops-api/) et ops-api (min 32 chars).
# L'API refuse de demarrer sans. Ne parvient JAMAIS au navigateur.
OPS_API_TOKEN=change_me_with_a_long_random_secret_ops

# OPS_METRICS_TOKEN : Token optionnel pour /metrics d'ops-api (vide = ouvert
# sur le reseau interne, comme les autres API).
OPS_METRICS_TOKEN=
# Active les jobs Sentinel deja extraits vers les endpoints HTTP internes.
SCHEDULER_SENTINEL_ENABLED=true
SENTINEL_SURSIS_EXPIRE_INTERVAL_SECS=60
# Jetons internes du planificateur. Utiliser quatre secrets aleatoires distincts
# d'au moins 32 caracteres; ils ne donnent acces qu'aux routes POST de jobs.
SENTINEL_SCHEDULER_TOKEN=
NEXUS_SCHEDULER_TOKEN=
ATRIUM_SCHEDULER_TOKEN=
OPS_SCHEDULER_TOKEN=
# Active les domaines optionnels dans le processus `platform-api`. Activer la
# valeur correspondante en meme temps que le profil Compose (`full`, `nexus`
# ou `atrium`) afin que leurs bases et Redis soient disponibles.
NEXUS_API_ENABLED=false
ATRIUM_API_ENABLED=false
