# ==============================================================================
#                   CONFIGURATEUR D'ENVIRONNEMENT — LaBandeDuCanap
# ==============================================================================
# Ce fichier recense TOUTES les variables d'environnement lues par les
# `compose.*.yml` (core, auth, atrium, nexus, observability, tls) pour
# l'ensemble des microservices de la plateforme (Sentinel, Nexus, Atrium,
# Exploitation, Identite, Web et Infrastructure).
#
# Copiez ce fichier sous le nom `.env` a la racine du projet et adaptez les
# valeurs. Convention utilisee dans le compose :
#   VAR:?...  => REQUISE  — le compose refuse de demarrer si elle est absente/vide.
#   VAR:-...  => optionnelle, la valeur indiquee ici est le defaut du compose.
# Les secrets (jetons, mots de passe) doivent etre des chaines aleatoires
# distinctes d'au moins 32 caracteres. Utilisez `:?` mentalement : un secret
# vide n'est PAS un secret absent (cf. CLAUDE.md).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFRASTRUCTURE COMMUNE (PostgreSQL, Redis, Docker, logs)
# ------------------------------------------------------------------------------
# POSTGRES_PASSWORD [REQUIS] : Mot de passe du compte SUPERUSER `sentinel` du
# cluster. Il ne sert plus qu'aux one-shot `*-db-init` (creation des roles et
# des bases) et a pgadmin. AUCUN service applicatif ne s'y connecte : un
# superuser ignore tous les GRANT, donc ses identifiants ouvriraient les cinq
# bases.
POSTGRES_PASSWORD=sentinel_secret

# Mots de passe des roles APPLICATIFS, un par base logique. Chacun ne possede
# que sa propre base et ne peut pas ouvrir de session sur les autres.
# SENTINEL_DB_PASSWORD [REQUIS] : role `sentinel_app` (base discord_sentinel) —
# utilise par sentinel-api et sentinel-worker (via platform-api).
SENTINEL_DB_PASSWORD=sentinel_app_secret
# OPS_DB_PASSWORD [REQUIS] : role restreint `sentinel_ops` (base discord_sentinel)
# via son pool dedie `ops-pgbouncer`. Non proprietaire, droits derives du SQL
# reellement execute par ops-api. Distinct de SENTINEL_DB_PASSWORD : ops-api est
# le seul service a cumuler l'acces base ET le jeton d'administration de l'hote.
OPS_DB_PASSWORD=ops_secret
# ATRIUM_DB_PASSWORD [REQUIS] : role `atrium` (base atrium).
ATRIUM_DB_PASSWORD=atrium_secret
# NEXUS_DB_PASSWORD [REQUIS] : role `nexus` (base nexus).
NEXUS_DB_PASSWORD=nexus_secret
# AUTH_DB_PASSWORD [REQUIS] : role `auth` (base auth). Cette base contient les
# access/refresh tokens Discord des administrateurs : c'est la plus sensible.
AUTH_DB_PASSWORD=auth_secret

# REDIS_PASSWORD [REQUIS] : mot de passe de l'instance Redis COMMUNE (bus
# d'evenements `sentinel:events` + cache). Portee par les bots, workers et la
# gateway.
REDIS_PASSWORD=sentinel_redis
# NEXUS_REDIS_PASSWORD [REQUIS] : instance Redis DEDIEE a Nexus (`nexus-redis`).
# Porte `nexus:events` et les reservations de ports de jeu, reglee en
# `noeviction` (evincer une reservation ferait attribuer le meme port a deux
# serveurs).
NEXUS_REDIS_PASSWORD=nexus_redis_secret
# AUTH_REDIS_PASSWORD [REQUIS] : instance Redis DEDIEE a l'identite
# (`auth-redis`). Porte les `state` CSRF OAuth et le cache « jeton -> identite ».
# Ne persiste rien sur disque, joignable seulement par auth-api.
AUTH_REDIS_PASSWORD=auth_redis_secret

# DOCKER_GID : ID numerique du groupe `docker` sur l'hote (proprietaire du socket
# /var/run/docker.sock). Porte par le SEUL conteneur qui monte le socket :
# docker-agent. Obtenir avec : stat -c '%g' /var/run/docker.sock
DOCKER_GID=988

# RUST_LOG : niveau de log des services Rust (error/warn/info/debug/trace).
RUST_LOG=info

# GRPC_TLS_DIR : repertoire (monte dans les conteneurs) des certificats mTLS gRPC
# partages entre les services concernes. Defaut : /grpc-certs.
GRPC_TLS_DIR=/grpc-certs

# ------------------------------------------------------------------------------
# 2. SENTINEL — API BACKEND & SECURITE ADMINISTRATEUR
# ------------------------------------------------------------------------------
# SENTINEL_API_KEY : cle d'API partagee pour authentifier les appels internes
# vers l'API Sentinel. (Alias de repli historique : API_KEY.)
SENTINEL_API_KEY=your_sentinel_api_key_here

# SENTINEL_REQUIRE_API_KEY : si `true` (defaut prod), exige SENTINEL_API_KEY sur
# les requetes HTTP. `false` uniquement en dev local sans authentification.
SENTINEL_REQUIRE_API_KEY=false

# PLATFORM_EVENTS_HMAC_KEY [REQUIS] : secret de signature HMAC-SHA256 des events
# destructifs publies sur `sentinel:events` (guild_reset, guild_backup:restore).
# `sentinel:events` vit sur le Redis commun ; sans signature, tout porteur de
# REDIS_URL pourrait declencher une purge de guilde. Le bot rejette un event non
# ou mal signe.
PLATFORM_EVENTS_HMAC_KEY=change_me_with_a_long_random_hmac_secret

# ALLOWED_ORIGINS : domaines autorises pour les requetes CORS (separes par
# virgule). En prod avec nginx sur le meme domaine : laisser vide (proxy
# relatif). Sinon URL exacte (ex: https://labandeducanap.fr,http://localhost:5173).
ALLOWED_ORIGINS=

# SUPERADMIN_USER_IDS : IDs Discord des Super-Administrateurs autorises sur le
# Back-Office (separes par virgule). FAIL-CLOSED : liste vide = acces interdit a
# TOUS (403). Lue UNIQUEMENT par auth-api.
SUPERADMIN_USER_IDS=123456789012345678,987654321098765432

# RBAC_GLOBAL_GATE : `true` (defaut) active le controle d'acces RBAC global.
RBAC_GLOBAL_GATE=true

# TRUST_PROXY_HOPS : nombre de proxys de confiance devant l'API pour extraire
# l'IP client reelle (X-Forwarded-For). 1 = un seul nginx en frontal.
TRUST_PROXY_HOPS=1

# SHARD_MODE : mode de sharding du bot Discord (`single` par defaut).
SHARD_MODE=single

# SECURITY_ALERTS_WEBHOOK : webhook Discord optionnel pour l'envoi direct des
# alertes de securite critiques.
SECURITY_ALERTS_WEBHOOK=

# METRICS_TOKEN [REQUIS] : token securisant les endpoints /metrics Prometheus.
# Sert aussi de repli pour NEXUS/OPS/ATRIUM_METRICS_TOKEN.
METRICS_TOKEN=change_me_with_a_long_random_metrics_token

# ------------------------------------------------------------------------------
# 3. SENTINEL — BOT DISCORD PRINCIPAL & AUTHENTIFICATION OAUTH2
# ------------------------------------------------------------------------------
# SENTINEL_BOT_TOKEN : token du Bot Discord principal Sentinel (Moderation,
# Tickets, Vocaux, Niveaux, Securite). Alias de repli : SENTINEL_DISCORD_TOKEN,
# DISCORD_TOKEN.
SENTINEL_BOT_TOKEN=your_sentinel_bot_token_here

# MESSAGE_CACHE_SIZE : nombre de messages recents conserves en RAM par serveur
# (contenu precedent d'une edition/suppression). Borne 100..100000, defaut 10000.
MESSAGE_CACHE_SIZE=10000

# DISCORD_CLIENT_ID : Client ID de l'application Discord (Developer Portal),
# utilise pour l'OAuth2 des utilisateurs sur le Back-Office.
DISCORD_CLIENT_ID=your_discord_client_id_here

# DISCORD_CLIENT_SECRET : Client Secret Discord (NE JAMAIS EXPOSER COTE FRONTEND).
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# DISCORD_REDIRECT_URI : URL de redirection OAuth2 enregistree dans le portail
# Discord. Ex prod : https://labandeducanap.fr/auth/discord/callback
DISCORD_REDIRECT_URI=https://labandeducanap.fr/auth/discord/callback

# WEB_FRONT_URL : URL absolue du frontend ou rediriger apres validation OAuth2.
# Ex : https://labandeducanap.fr ou http://localhost:5173 en dev.
WEB_FRONT_URL=https://labandeducanap.fr

# ------------------------------------------------------------------------------
# 4. SENTINEL — IA DE MODERATION DU CHAT (DeepSeek LLM)
# ------------------------------------------------------------------------------
# DEEPSEEK_MODERATION_API_KEY : cle API Cloud DeepSeek isolee, dediee a la
# moderation du chat (budget suivi separement).
DEEPSEEK_MODERATION_API_KEY=your_deepseek_moderation_api_key_here

# DEEPSEEK_MODERATION_MODEL : modele LLM de moderation (defaut: deepseek-chat).
DEEPSEEK_MODERATION_MODEL=deepseek-chat

# DEEPSEEK_MODERATION_ENDPOINT : URL de l'API OpenAI-compatible (defaut DeepSeek).
DEEPSEEK_MODERATION_ENDPOINT=https://api.deepseek.com/chat/completions

# ------------------------------------------------------------------------------
# 5. MODULES SENTINEL OPTIONNELS (Voice & Tickets)
# ------------------------------------------------------------------------------
# VOICE_GUILD_ID : serveur cible du module de salons vocaux dynamiques.
VOICE_GUILD_ID=your_guild_id
# VOICE_PUBLIC_CREATOR_CHANNEL_ID : salon declencheur des vocaux publics.
VOICE_PUBLIC_CREATOR_CHANNEL_ID=your_public_creator_channel_id
# VOICE_PRIVATE_CREATOR_CHANNEL_ID : salon declencheur des vocaux prives.
VOICE_PRIVATE_CREATOR_CHANNEL_ID=your_private_creator_channel_id
# VOICE_LOG_CHANNEL_ID : salon texte des evenements du module vocal.
VOICE_LOG_CHANNEL_ID=your_log_channel_id

# TICKET_CATEGORY_ID : categorie sous laquelle sont crees les tickets de support.
TICKET_CATEGORY_ID=your_ticket_category_id
# TICKET_CHANNEL_ID : salon ou le panneau d'ouverture de tickets est affiche.
TICKET_CHANNEL_ID=your_ticket_channel_id

# ------------------------------------------------------------------------------
# 6. ATRIUM — IA D'ACCUEIL, RAG & BOT D'INTERACTION
# ------------------------------------------------------------------------------
# ATRIUM_DISCORD_TOKEN : token du Bot Discord dedie a l'accueil Atrium.
ATRIUM_DISCORD_TOKEN=your_atrium_discord_token_here

# ATRIUM_API_TOKEN [REQUIS si atrium] : jeton HTTP partage Atrium-Bot <-> API,
# injecte cote serveur par nginx dans /atrium-api/. Min 32 chars. Ne parvient
# JAMAIS au navigateur. Sans lui, « Accueil IA » repond 401.
ATRIUM_API_TOKEN=change_me_with_a_long_random_secret_atrium

# ATRIUM_GRPC_TOKEN [REQUIS si atrium] : jeton Bearer interne Bot <-> API gRPC
# (min 32 chars, DISTINCT de l'API HTTP).
ATRIUM_GRPC_TOKEN=change_me_with_a_different_long_random_grpc_secret

# ATRIUM_DEEPSEEK_API_KEY : cle DeepSeek dediee a l'accueil/RAG Atrium.
# Repli : DEEPSEEK_API_KEY.
ATRIUM_DEEPSEEK_API_KEY=your_atrium_deepseek_api_key_here
# ATRIUM_DEEPSEEK_MODEL : modele DeepSeek Atrium (defaut: deepseek-v4-flash).
ATRIUM_DEEPSEEK_MODEL=deepseek-v4-flash

# ATRIUM_GENERAL_CHANNEL_ID : salon general ou le bot Atrium accueille les membres.
ATRIUM_GENERAL_CHANNEL_ID=your_general_channel_id_here
# ATRIUM_SERVER_CONTEXT : description contextuelle du serveur fournie a l'IA.
ATRIUM_SERVER_CONTEXT="Serveur gaming convivial dedie a la communaute LaBandeDuCanap."

# ATRIUM_API_RATE_LIMIT_PER_SEC : limite HTTP/s par IP sur l'API Atrium (defaut 5).
ATRIUM_API_RATE_LIMIT_PER_SEC=5
# ATRIUM_METRICS_TOKEN : token /metrics Atrium (repli sur METRICS_TOKEN).
ATRIUM_METRICS_TOKEN=

# Quotas de REPLI (un serveur sans reglage). Le reglage par serveur se fait dans
# la page « Accueil IA » et vit dans bot_guild_config (base atrium).
# ATRIUM_USER_COOLDOWN_SECS : delai entre 2 questions d'un membre (defaut 10).
ATRIUM_USER_COOLDOWN_SECS=10
# ATRIUM_USER_DAILY_LIMIT : quota de questions/jour/utilisateur (defaut 30).
ATRIUM_USER_DAILY_LIMIT=30
# ATRIUM_GLOBAL_DAILY_LIMIT : quota global de questions/jour (defaut 500).
ATRIUM_GLOBAL_DAILY_LIMIT=500
# ATRIUM_MEMORY_RETENTION_DAYS : retention de la memoire conversationnelle (90).
ATRIUM_MEMORY_RETENTION_DAYS=90

# ATRIUM_RAG_DATABASE_URL : connexion Postgres au RAG. En Docker : laisser vide
# (deduit automatiquement via atrium-pgbouncer).
ATRIUM_RAG_DATABASE_URL=

# ATRIUM_EMBEDDINGS_BASE_URL : API d'embeddings. Defaut Docker : Ollama local
# gratuit. Si OpenAI : https://api.openai.com/v1
ATRIUM_EMBEDDINGS_BASE_URL=http://atrium-ollama:11434/v1
# ATRIUM_EMBEDDINGS_API_KEY : cle des embeddings (vide si Ollama local).
ATRIUM_EMBEDDINGS_API_KEY=
# ATRIUM_EMBEDDINGS_MODEL : modele d'embeddings (defaut Ollama: nomic-embed-text).
ATRIUM_EMBEDDINGS_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# 7. NEXUS — PLATEFORME DE SERVEURS DE JEUX
# ------------------------------------------------------------------------------
# NEXUS_BOT_TOKEN : token du Bot Discord du portail de jeux. Repli :
# NEXUS_DISCORD_TOKEN.
NEXUS_BOT_TOKEN=your_nexus_bot_token_here

# NEXUS_API_KEY [REQUIS si nexus] : cle d'API interne Nexus-API/Bot/Worker.
NEXUS_API_KEY=your_nexus_api_key_here

# NEXUS_ALLOWED_ORIGINS : CORS Nexus (repli sur ALLOWED_ORIGINS).
NEXUS_ALLOWED_ORIGINS=
# NEXUS_RATE_LIMIT_PER_SEC : limite HTTP/s par IP (defaut 50).
NEXUS_RATE_LIMIT_PER_SEC=50
# NEXUS_HEAVY_RATE_LIMIT_PER_SEC : limite des routes couteuses (defaut 2).
NEXUS_HEAVY_RATE_LIMIT_PER_SEC=2
# NEXUS_MAX_BODY_SIZE : taille max du corps de requete en octets (defaut 10 Mio).
NEXUS_MAX_BODY_SIZE=10485760
# NEXUS_METRICS_TOKEN : token /metrics Nexus (repli sur METRICS_TOKEN).
NEXUS_METRICS_TOKEN=

# NEXUS_GAME_RUNTIME : runtime des conteneurs de jeux. `docker` (prod reel) ou
# `noop` (mock dev). Defaut compose : noop.
NEXUS_GAME_RUNTIME=docker

# NEXUS_DATABASE_URL / NEXUS_REDIS_URL : deduits automatiquement en Docker,
# laisser vide.
NEXUS_DATABASE_URL=
NEXUS_REDIS_URL=

# NEXUS_DB_MAX_CONNECTIONS [optionnel, defaut 20] : taille du pool de connexions
# DB de nexus-api (partage entre requetes et verrous de jobs). Relever si les
# jobs echouent en "pool timed out" ; rester sous le pool serveur de
# nexus-pgbouncer et le max_connections de Postgres (150).
NEXUS_DB_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# 8. DOCKER-AGENT (socket Docker de l'hote — liste blanche stricte)
# ------------------------------------------------------------------------------
# DOCKER_AGENT_TOKEN [REQUIS] : jeton de la surface HOTE (/version, /containers,
# /prune…), porte par ops-api. Min 32 chars. L'agent est le SEUL a monter le
# socket (= root sur l'hote) et refuse de demarrer sans ce jeton.
DOCKER_AGENT_TOKEN=change_me_with_a_long_random_secret_docker_agent

# DOCKER_AGENT_GAME_TOKEN [REQUIS si nexus] : jeton de la surface /game/* (cycle
# de vie des serveurs de jeu), porte par nexus-api. DOIT etre DIFFERENT du
# precedent — l'agent refuse de demarrer s'ils sont identiques. Requis meme avec
# NEXUS_GAME_RUNTIME=noop.
DOCKER_AGENT_GAME_TOKEN=change_me_with_a_different_long_random_secret_game

# Politique locale du docker-agent pour les serveurs Nexus. Une image ajoutee
# dans game_templates doit aussi etre ajoutee ici (avec son digest @sha256) avant
# de pouvoir etre tiree/executee. root/command sont des sous-ensembles explicites.
# Laisser vide utilise les listes par defaut (digests epingles) du compose.
DOCKER_AGENT_GAME_IMAGES=
DOCKER_AGENT_GAME_ROOT_IMAGES=
DOCKER_AGENT_GAME_COMMAND_IMAGES=
DOCKER_AGENT_GAME_NETWORK=sentinel-games
DOCKER_AGENT_GAME_CONTAINER_USER=1000:1000
# Plafond de coeurs allouables a UN serveur de jeu. L'agent le fait respecter
# quoi que demande l'API : c'est une protection de l'hote, pas un reglage de
# confort. A ajuster selon le nombre de processeurs logiques de la machine.
DOCKER_AGENT_MAX_CPU_LIMIT=16

DOCKER_AGENT_GAME_PORT_START=25500
DOCKER_AGENT_GAME_PORT_END=25599
DOCKER_AGENT_RCON_PORT_START=25700
DOCKER_AGENT_RCON_PORT_END=25799

# ------------------------------------------------------------------------------
# 9. IDENTITE (auth-api)
# ------------------------------------------------------------------------------
# AUTH_API_TOKEN [REQUIS] : jeton des appelants de service de l'API d'identite
# (nginx pour l'auth_request, sentinel-api et ops-api comme consommateurs).
# Min 32 chars. Sans lui, /access et /security/* seraient ouverts au reseau interne.
AUTH_API_TOKEN=change_me_with_a_long_random_secret_auth

# ------------------------------------------------------------------------------
# 10. EXPLOITATION (ops-api) & GEOIP
# ------------------------------------------------------------------------------
# OPS_API_TOKEN [REQUIS] : jeton entre nginx (/ops-api/) et ops-api (min 32 chars).
# L'API refuse de demarrer sans. Ne parvient JAMAIS au navigateur.
OPS_API_TOKEN=change_me_with_a_long_random_secret_ops

# OPS_METRICS_TOKEN : token /metrics ops-api (repli sur METRICS_TOKEN).
OPS_METRICS_TOKEN=

# OPS_GEOIP_ENABLED : autorise la resolution geographique des IP par un service
# TIERS. Desactivee par defaut. Une IP est une donnee personnelle (RGPD) :
# l'activer transfere les IP des visiteurs a un prestataire externe. Desactivee,
# l'ecran Securite affiche les IP sans pays — il ne casse pas.
OPS_GEOIP_ENABLED=false
# OPS_GEOIP_URL : point de terminaison de la resolution. Le defaut (ip-api.com,
# palier gratuit) circule EN CLAIR (http://). Pointer sur un service TLS supprime
# cette exposition.
OPS_GEOIP_URL=http://ip-api.com/batch
# OPS_GEOIP_ALLOW_PLAINTEXT : autorise explicitement une URL GeoIP en http://.
# `false` par defaut : garde-fou pour ne pas fuiter les IP en clair par accident.
OPS_GEOIP_ALLOW_PLAINTEXT=false

# ------------------------------------------------------------------------------
# 11. PLANIFICATEUR (platform-scheduler) & JETONS DE JOBS
# ------------------------------------------------------------------------------
# Jetons internes du planificateur vers les routes POST de jobs. Quatre secrets
# aleatoires DISTINCTS d'au moins 32 caracteres. Les quatre domaines sont
# toujours actifs dans l'unique platform-scheduler.
SENTINEL_SCHEDULER_TOKEN=change_me_scheduler_sentinel
OPS_SCHEDULER_TOKEN=change_me_scheduler_ops
NEXUS_SCHEDULER_TOKEN=
ATRIUM_SCHEDULER_TOKEN=

# ------------------------------------------------------------------------------
# 12. CADENCES DES JOBS (toutes optionnelles — defauts entre parentheses)
# ------------------------------------------------------------------------------
# --- Sentinel : IA & moderation ---
AI_POLL_INTERVAL=2                     # (2 s) poll de la file d'inference IA
AI_BATCH_SIZE=5                        # (5) taille de lot IA
AI_JOB_TIMEOUT=120                     # (120 s) timeout d'un job IA
SENTINEL_SURSIS_EXPIRE_INTERVAL_SECS=60
APPEAL_SLA_SCAN_INTERVAL=120
SEND_REMINDERS_INTERVAL=30
TEMP_ROLES_SCAN_INTERVAL=60
AGE_UNBAN_INTERVAL=2592000             # (30 j) leve des bans temporaires
BAN_CLEANUP_INTERVAL=1
QUARANTINE_KICK_CHECK_SECS=15
QUARANTINE_REMINDER_CHECK_SECS=15      # (15 s) balayage des rappels de reglement
                                       # Le DELAI laisse au membre et la date du
                                       # rappel ne sont PAS ici : ce sont des
                                       # reglages par serveur (module Securite du
                                       # tableau de bord).
LOCKDOWN_EXPIRE_CHECK_SECS=15
SLOWMODE_EXPIRE_CHECK_SECS=15
AUTOMOD_CLOSE_VOTES_SECS=60
AUTOMOD_CLEANUP_CARDS_SECS=86400

# --- Sentinel : tickets ---
TICKETS_SLA_CHECK_INTERVAL=300
TICKETS_CLOSE_INACTIVE_INTERVAL=1800
CLOSED_TICKETS_RETENTION_DAYS=180

# --- Sentinel : annonces ---
ANNOUNCEMENT_PUBLISH_INTERVAL_SECS=3600
ANNOUNCEMENTS_FETCH_LIMIT_GLOBAL=200
ANNOUNCEMENTS_RETENTION_CHECK=86400

# --- Sentinel : analytics, niveaux & caches ---
ANALYTICS_REFRESH_INTERVAL=300
ANALYTICS_RETENTION_CHECK=86400
DASHBOARD_REFRESH_INTERVAL=600
LEADERBOARDS_REFRESH_INTERVAL=300
VOICE_STATS_REFRESH_INTERVAL=3600
TOP_USERS_PUBLISH_CHECK=3600
MONTHLY_RANKING_CHECK_SECS=3600
AUDIT_CACHE_REFRESH_INTERVAL=60
AUDIT_SYNC_INTERVAL=300
USER_CACHE_SYNC_INTERVAL=900
WATCHED_USERS_QUERY_LIMIT=10000

# --- Sentinel : securite & monitoring ---
SECURITY_ALERTS_INTERVAL_SECS=300
MONITOR_CHECK_INTERVAL=30
# Sondes de connectivite de l'hote, format `Libelle=hote:port` separes par des
# virgules. Une connexion TCP, pas un ping : beaucoup de reseaux filtrent
# l'ICMP, un ping perdu ne prouverait donc rien.
#
# Le defaut sonde Discord (ce dont tout depend ici) et un DNS public qui sert
# de temoin : Discord injoignable alors que le temoin repond designe Discord,
# pas la machine.
OPS_INTERNET_PROBES=Discord=discord.com:443,Internet=1.1.1.1:443

HOST_METRICS_INTERVAL_SECS=30

# --- Sentinel : exports ---
EXPORT_SCAN_INTERVAL=5
EXPORT_PROCESSING_TIMEOUT_SECS=300
MAX_ROWS_PER_EXPORT=50000

# --- Sentinel : sauvegardes de guilde ---
GUILD_BACKUP_AUTO_CHECK_INTERVAL=1800
HOURLY_SNAPSHOT_INTERVAL=60
DAILY_SNAPSHOT_INTERVAL=1

# --- Sentinel : nettoyage & maintenance base ---
CLEANUP_INTERVAL_HOURS=1
LOGS_RETENTION_DAYS=30
VOICE_SESSIONS_RETENTION_DAYS=90
PARTITION_MANAGER_INTERVAL=86400
VACUUM_ENABLED=true
VACUUM_INTERVAL_HOURS=24

# --- Nexus : serveurs de jeux ---
GAME_AUTO_START_INTERVAL_SECS=60
# Verification des jeux mentionnables (roles Discord vs dashboard). Demande
# leur inventaire aux guildes ; ne repare rien tout seul. 6 h par defaut : une
# desynchronisation n'est pas une urgence et chaque passage fait travailler le bot.
GAME_MENTION_SYNC_INTERVAL_SECS=21600
# Fermeture des defis Coussin Piege laisses sans reponse (echeance 24 h). Tant
# qu'un defi traine, l'attaquant reste en delai d'attente pour une bagarre qui
# n'a pas eu lieu.
COUSSIN_EXPIRE_COMBATS_INTERVAL_SECS=900
# Fouilles (/chiper) dont la fenetre de defense s'est fermee sans reaction.
# Passage court : la fenetre dure une minute, un denouement qui arrive dix
# minutes plus tard ne raconte plus rien a personne.
COUSSIN_EXPIRE_STEALS_INTERVAL_SECS=20
# Surveillance des serveurs de jeu (seuils CPU/RAM/temps de reponse -> webhook
# Discord). Cadence alignee sur le controle de sante, qui produit les mesures.
GAME_ALERTS_INTERVAL_SECS=60
# Ouverture/fermeture automatique des serveurs selon leurs plages horaires.
# Passage a la minute : une plage se termine a la minute pres, et un preavis de
# dix minutes annonce a la neuvieme n'a plus grand interet.
GAME_SCHEDULES_INTERVAL_SECS=60
GAME_HEALTH_CHECK_INTERVAL_SECS=30
GAME_IDLE_SHUTDOWN_CHECK_INTERVAL_SECS=3600
GAME_RECONCILER_INTERVAL_SECS=3600
GAME_IMAGE_CLEANUP_INTERVAL_SECS=86400
GAME_REVEAL_IP_INTERVAL_SECS=300
GAME_DAILY_PING_INTERVAL_SECS=3600

# --- Atrium ---
ATRIUM_SUMMARY_INTERVAL_SECS=86400
ATRIUM_RETENTION_INTERVAL_SECS=86400

# ------------------------------------------------------------------------------
# 13. WEB DASHBOARD & CERTIFICATS TLS / LET'S ENCRYPT
# ------------------------------------------------------------------------------
# WEB_DOMAIN : nom de domaine public (ex: labandeducanap.fr ou localhost en dev).
WEB_DOMAIN=localhost
# WEB_DOMAIN_ALIASES : autres noms DNS servis par le meme nginx (virgules),
# ajoutes au certificat Let's Encrypt. Vide si aucun.
WEB_DOMAIN_ALIASES=

# PUBLIC_GUILD_ID : serveur Discord principal dont les donnees (planning, jeux)
# sont affichees sur le site public.
PUBLIC_GUILD_ID=123456789012345678
# DISCORD_INVITE : lien d'invitation Discord affiche sur le site (ex:
# https://discord.gg/votre_code).
DISCORD_INVITE=https://discord.gg/your_invite_code

# VITE_API_URL : URL absolue de l'API pour le frontend Vue. Vide si l'API est
# servie sous le meme nginx (relatif).
VITE_API_URL=

# LETSENCRYPT_EMAIL : email d'enregistrement des certificats Let's Encrypt.
LETSENCRYPT_EMAIL=your_email@domain.com
# LETSENCRYPT_STAGING : "1" = environnement de test (evite le rate-limit). Vide = Prod.
LETSENCRYPT_STAGING=

# ------------------------------------------------------------------------------
# 14. OBSERVABILITE (profils `observability` / `monitoring` : Grafana, PgAdmin)
# ------------------------------------------------------------------------------
# GRAFANA_USER / GRAFANA_PASSWORD [REQUIS si observability] : identifiants admin
# de l'interface Grafana.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_admin

# PGADMIN_EMAIL / PGADMIN_PASSWORD : connexion pgAdmin (service standard).
# Utiliser un domaine reel : pgAdmin refuse les domaines reserves comme `.local`.
PGADMIN_EMAIL=admin@labandeducanap.fr
PGADMIN_PASSWORD=admin_password_here

# Lecture de l'activite de jeu des membres (compteur « En partie »).
# ATTENTION A L'ORDRE : cocher d'abord « Presence Intent » dans le portail
# Discord Developer, PUIS passer ceci a true. Demander l'intent sans l'avoir
# autorise fait REFUSER la connexion du bot, qui ne demarre plus du tout.
NEXUS_PRESENCE_INTENT=false
