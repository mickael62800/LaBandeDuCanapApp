# Variables d'environnement pour les tests d'integration
# Utilise par docker-compose.test.yml + infrastructure/scripts/run-tests.*

DATABASE_URL=postgres://sentinel_test:sentinel_test@localhost:5433/sentinel_test
REDIS_URL=redis://localhost:6380

# API
SENTINEL_API_KEY=
SENTINEL_REQUIRE_API_KEY=false
BIND_ADDR=0.0.0.0:3001

# Inference (desactivee pour les tests)
TEXT_MODEL_PATH=
VISION_MODEL_PATH=
TEXT_TOKENIZER_PATH=
TEXT_MAX_LENGTH=512

# Rate limiting (permissif pour les tests)
RATE_LIMIT_PER_SEC=1000
HEAVY_RATE_LIMIT_PER_SEC=100
INFERENCE_MAX_CONCURRENT=4
