# syntax=docker/dockerfile:1.7
# ============================================================================
# Generic Alpine Rust builder — utilise par gateway, sentinel-bot, et les 13
# workers. Remplace 15 Dockerfiles quasi-identiques par un seul parametre via
# BIN_NAME.
#
# Build args :
#   BIN_NAME    (requis)  ex: sentinel-analytics-worker
#   CHEF_IMAGE  (optional) image cargo-chef base, epinglee par digest.
#
# Compose example :
#   build:
#     context: ../..
#     dockerfile: infrastructure/docker/Dockerfile.rust-alpine
#     args:
#       BIN_NAME: sentinel-analytics-worker
#
# Optimisations :
#   - cargo-chef : deps cookees une fois, cachees par BuildKit.
#   - sharing=private : permet builds parallels (`docker buildx bake`) sans
#     verrou global sur le cache.
#   - User non-root (uid 1000) au runtime.
#   - Binaire renomme en /usr/local/bin/sentinel-app pour un ENTRYPOINT
#     uniforme (le service_label vrai est passe explicitement par chaque
#     binaire via spawn_metrics_server / tracing fields).
# ============================================================================

ARG CHEF_IMAGE=lukemathwalker/cargo-chef:latest-rust-alpine@sha256:980619ec8e88608ad967ee0fb697ed3b3e4368acdbac71e5e85ae61f9e2f1a2a
FROM ${CHEF_IMAGE} AS chef
RUN apk add --no-cache \
    musl-dev pkgconf openssl-dev openssl-libs-static \
    protoc protobuf-dev \
    make g++ linux-headers
WORKDIR /app

# ----- Planner -----
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ----- Builder -----
FROM chef AS builder
ARG BIN_NAME
RUN test -n "$BIN_NAME" || (echo "ERROR: BIN_NAME build-arg requis" && exit 1)
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=private \
    --mount=type=cache,target=/app/target,sharing=private \
    cargo chef cook --release --recipe-path recipe.json --bin "$BIN_NAME"
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=private \
    --mount=type=cache,target=/app/target,sharing=private \
    cargo build --release --bin "$BIN_NAME" && \
    cp "target/release/$BIN_NAME" /tmp/app

# ----- Runtime -----
FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d AS runtime
# ttf-dejavu : police systeme pour le rendu d images (classements via
# resvg). Chargee par fontdb.load_system_fonts(). ca-certificates pour TLS.
RUN apk add --no-cache ca-certificates ttf-dejavu openssl && \
    addgroup -g 1000 -S sentinel && \
    adduser -u 1000 -S -G sentinel sentinel && \
    mkdir -p /app && chown -R sentinel:sentinel /app

COPY --from=builder /tmp/app /usr/local/bin/sentinel-app

WORKDIR /app
USER sentinel
ENTRYPOINT ["/usr/local/bin/sentinel-app"]
