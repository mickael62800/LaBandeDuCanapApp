# syntax=docker/dockerfile:1.7
# ============================================================================
# Debian Trixie Rust builder — variant glibc-based, requis pour ONNX Runtime
# (glibc >= 2.38). Utilise UNIQUEMENT par l'API.
#
# Build args :
#   BIN_NAME                  (requis) ex: sentinel-api
#   MIGRATIONS_SRC            (optional) ex: sentinel-api/migrations
#   GRPC_HEALTH_PROBE_VERSION (optional) defaut: v0.4.24
#   CHEF_IMAGE                (optional) image base cargo-chef
#
# Healthcheck : binaire grpc_health_probe inclus pour `grpc_health_probe -addr=:50051`.
# Compatible avec le service tonic-health expose par l'API.
#
# TODO #11 : envisager `gcr.io/distroless/cc-debian12` au runtime pour passer
# de ~80 MB a ~25 MB et supprimer la surface d'attaque (pas de shell). Bloque
# par la dependance ONNX Runtime sur glibc 2.38+ (debian12 = 2.36).
# Alternative : `cgr.dev/chainguard/glibc-dynamic` qui fournit glibc 2.39+.
# ============================================================================

ARG CHEF_IMAGE=lukemathwalker/cargo-chef:latest-rust-slim-trixie@sha256:c7569b097797bc1f3d86a8b6f8a056dc336d05c6f57dd81eb0486948f986dccd
FROM ${CHEF_IMAGE} AS chef
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential pkg-config libssl-dev ca-certificates g++ \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# ----- Planner -----
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ----- Builder -----
FROM chef AS builder
ARG BIN_NAME
ARG MIGRATIONS_SRC=
RUN test -n "$BIN_NAME" || (echo "ERROR: BIN_NAME build-arg requis" && exit 1)
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=private \
    --mount=type=cache,target=/app/target,sharing=private \
    cargo chef cook --release --recipe-path recipe.json --bin "$BIN_NAME"
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=private \
    --mount=type=cache,target=/app/target,sharing=private \
    cargo build --release --bin "$BIN_NAME" && \
    cp "target/release/$BIN_NAME" /tmp/app && \
    mkdir -p /tmp/migrations && \
    if [ -n "$MIGRATIONS_SRC" ] && [ -d "$MIGRATIONS_SRC" ]; then \
        cp -r "$MIGRATIONS_SRC"/. /tmp/migrations/; \
    fi

# ----- Runtime -----
FROM debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258 AS runtime
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.24
ARG GRPC_HEALTH_PROBE_SHA256=7e564681110ee4563637457b91e42f62f96b79618a835bb05ae2305acdcc3db0
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3t64 libstdc++6 openssl wget \
    && wget -q -O /usr/local/bin/grpc_health_probe \
       "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64" \
    && echo "${GRPC_HEALTH_PROBE_SHA256}  /usr/local/bin/grpc_health_probe" | sha256sum -c - \
    && chmod +x /usr/local/bin/grpc_health_probe \
    && apt-get purge -y wget \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -g 1000 sentinel \
    && useradd -r -u 1000 -g sentinel -d /app sentinel \
    && mkdir -p /app && chown -R sentinel:sentinel /app

COPY --from=builder /tmp/app /usr/local/bin/sentinel-app
COPY --from=builder --chown=sentinel:sentinel /tmp/migrations /app/migrations

WORKDIR /app
USER sentinel
EXPOSE 3000 50051
ENTRYPOINT ["/usr/local/bin/sentinel-app"]
