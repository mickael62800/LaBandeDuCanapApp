[package]
name = "sentinel-api"
version = "0.1.0"
edition = "2021"
description = "Backend API de DiscordSentinel — le cerveau de la modération"

[[bin]]
name = "sentinel-api"
path = "src/main.rs"

[lib]
name = "sentinel_api"
path = "src/lib.rs"

[dependencies]
hmac = "0.12"
sha2 = "0.10"
# Web
axum = { version = "0.8", features = ["macros", "multipart"] }
tokio = { workspace = true }
tower = { version = "0.5", features = ["limit", "load-shed"] }
tower-http = { version = "0.6", features = ["cors", "trace", "limit", "request-id", "propagate-header", "set-header", "compression-zstd", "compression-gzip"] }

# Database
sqlx = { workspace = true }

# Cache
redis = { workspace = true }

# Serialization
serde = { workspace = true }
serde_json = { workspace = true }

# Observability
tracing = { workspace = true }
tracing-subscriber = { workspace = true }
metrics = "0.24"
metrics-exporter-prometheus = { version = "0.16", default-features = false }
tokio-metrics = { version = "0.4", default-features = false, features = ["rt"] }

# AI / Inference ONNX
ort = "2.0.0-rc.12"
ndarray = "0.17"
base64 = "0.22"
tokenizers = { version = "0.21", default-features = false, features = ["fancy-regex"] }

# HTTP Client
reqwest = { workspace = true }

# gRPC interne (Phase 7A) — coexistence avec Axum sur un port distinct.
# Phase 7A optimisations : compression Gzip + tonic-health pour healthcheck.
tonic = { workspace = true }
tonic-health = "0.13"
prost = { workspace = true }
sentinel-proto = { workspace = true }
ops-core = { workspace = true }
sentinel-core = { workspace = true }
platform-common-api = { workspace = true }

# Utils
uuid = { workspace = true }
chrono = { workspace = true }
async-trait = { workspace = true }
dotenvy = { workspace = true }
futures-util = { workspace = true }
rand = { workspace = true }
# Metriques systeme (CPU/RAM/host). Utilise avec `pid: host` dans
# docker-compose pour voir les stats reelles de la machine et pas du conteneur.
sysinfo = { version = "0.33", default-features = false, features = ["system", "disk"] }
# Client Docker async natif (socket Unix /var/run/docker.sock).
# Utilise pour /api/docker/* (overview, containers, images, volumes, prune, logs).
# Generation d'archives tar en memoire pour upload_to_container (bollard
# attend un body application/x-tar pour poser des fichiers dans un container).
tar = "0.4"
dashmap = { workspace = true }
# Comparaison constant-time pour les Bearer tokens / API keys.
# Empeche les timing attacks qui devinent la cle caractere par caractere.
subtle = "2"
# Parse X.509 PEM pour endpoint /api/security/tls-cert (expiration Let's Encrypt)
x509-parser = "0.16"
# `ReceiverStream` pour exposer un mpsc en server-streaming gRPC (TamagotchiService.ListCards).
tokio-stream = "0.1"

[dev-dependencies]
http-body-util = "0.1"
tokio-stream = { version = "0.1", features = ["net"] }
# Active `test-util` pour `#[tokio::test(start_paused)]` et `tokio::time::pause()`
# utilises dans les tests de rate limiter / cooldowns.
tokio = { workspace = true, features = ["test-util"] }

# Phase 1 — Quick wins : jemalloc comme allocateur global (Linux/macOS uniquement,
# pas supporté sur MSVC Windows). Gain typique : -15 % RAM résidente sur API
# long-running grâce à une meilleure gestion de la fragmentation.
[target.'cfg(not(target_env = "msvc"))'.dependencies]
tikv-jemallocator = "0.6"

# `docker builder prune` (endpoint POST /build/prune) n'est PAS expose par bollard
# 0.18 : on tape le socket unix directement en HTTP/1 via hyper. Unix uniquement
# (le socket Docker en prod est /var/run/docker.sock).
[target.'cfg(unix)'.dependencies]
hyper = { version = "1", features = ["client", "http1"] }
hyper-util = { version = "0.1", features = ["tokio"] }
http-body-util = "0.1"

[lints]
workspace = true

# ═══════════════════════════════════════════════════════════════
# Tests — arborescence par type (unit / integration / e2e) puis
# par section metier (audit, moderation, blackjack, etc.).
# Cargo n'auto-decouvre pas les sous-dossiers de `tests/`, chaque
# binaire doit etre declare ici explicitement.
# ═══════════════════════════════════════════════════════════════

# ── Unit tests (use cases avec mocks in-memory, pas de DB) ──

# ── Integration par section metier (HTTP/DB selon fichier) ──

# audit
[[test]]
name = "integration_audit_db"

# automod
[[test]]
name = "integration_automod_db"

[[test]]
name = "integration_community_db"

